# =====================================================================
# Python
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# =====================================================================
# RAG Layer - بيانات وملفات لا يجب رفعها لـ Git
# =====================================================================

# قاعدة بيانات ChromaDB الفعلية (بيانات كبيرة الحجم ومُولَّدة، مش كود)
RAG/documents/.chroma_db/
**/chroma_db/
*.sqlite3

# النصوص القانونية الفعلية إذا كانت كبيرة (تُحمَّل من مصدر خارجي حسب الوثيقة)
# فك التعليق عن السطرين التاليين إذا قررت عدم رفع النصوص الفعلية لـ Git:
# RAG/documents/laws/*
# RAG/documents/regulations/*
# !RAG/documents/laws/.gitkeep
# !RAG/documents/regulations/.gitkeep

# نماذج الـ Embeddings المحمّلة محليًا (BGE-M3 cache من HuggingFace)
.cache/
**/sentence_transformers_cache/
**/huggingface/

# =====================================================================
# Inference Layer - النموذج الثنائي الكبير
# =====================================================================
Inference/models/*.gguf
*.gguf

# =====================================================================
# متغيرات البيئة والأسرار
# =====================================================================
.env
.env.local
*.env
secrets.env
Config/secrets.env

# =====================================================================
# IDE / محررات النصوص
# =====================================================================
.vscode/
.idea/
*.swp
*.swo

# =====================================================================
# نظام التشغيل
# =====================================================================
.DS_Store
Thumbs.db

# =====================================================================
# اللوجز والملفات المؤقتة
# =====================================================================
*.log
logs/
tmp/
*.tmp

# =====================================================================
# ملفات الرفع/المعالجة (Storage Layer - بيانات مستخدمين حقيقية)
# =====================================================================
Storage/files/uploads/*
Storage/files/processed/*
!Storage/files/uploads/.gitkeep
!Storage/files/processed/.gitkeep

# =====================================================================
# C++ Build artifacts (Application / Inference)
# =====================================================================
**/build/
**/CMakeFiles/
**/CMakeCache.txt
*.o
*.obj

# =====================================================================
# Node/TypeScript (Presentation)
# =====================================================================
node_modules/
dist/
.turbo/