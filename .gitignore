# =====================================================================
# SmartGovernmentAI — files that must NOT be pushed to GitHub
# =====================================================================

# ---------------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.env
Config/secrets.env
!Config/secrets.env.example

# ---------------------------------------------------------------------
# IDE / editor (local only)
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# ---------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# Logs & temp
# ---------------------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------
# Node / TypeScript (Presentation)
# ---------------------------------------------------------------------
node_modules/
.turbo/
Presentation/dist/

# ---------------------------------------------------------------------
# C++ build artifacts
# ---------------------------------------------------------------------
**/CMakeFiles/
**/CMakeCache.txt
cmake-build-*/
*.o
*.obj
*.pdb
*.ilk
*.exp

# ---------------------------------------------------------------------
# Inference — GGUF models (put file here: Inference/models/)
# ---------------------------------------------------------------------
*.gguf
!Inference/models/README.md
!Inference/models/model_registry.json

# ---------------------------------------------------------------------
# Inference — llama-server binaries (put here: Inference/llama_server/)
# Keep launchers + build config; ignore runtime binaries
# ---------------------------------------------------------------------
Inference/llama_server/*.exe
Inference/llama_server/*.dll
Inference/llama_server/output.log
!Inference/llama_server/server_launcher.sh
!Inference/llama_server/server_launcher.bat
!Inference/llama_server/build_config.cmake
!Inference/llama_server/README.md

# ---------------------------------------------------------------------
# Optimization — ONNX models (put file here: Optimization/models/)
# ---------------------------------------------------------------------
*.onnx
!Optimization/models/README.md
!Optimization/models/model_metadata.json

# ---------------------------------------------------------------------
# RAG — vector DB + embedding caches (generated locally)
# ---------------------------------------------------------------------
RAG/documents/.chroma_db/
RAG/documents/.turbovec/
RAG/documents/.faiss/
RAG/documents/manifest.json
RAG/documents/indexed_chunks.json
**/chroma_db/
**/.chroma/
*.sqlite3
.cache/
**/sentence_transformers_cache/
**/huggingface/
**/transformers_cache/

# ---------------------------------------------------------------------
# Storage — uploaded / processed user files (runtime data)
# ---------------------------------------------------------------------
Storage/files/uploads/*
Storage/files/processed/*
!Storage/files/uploads/.gitkeep
!Storage/files/processed/.gitkeep

# ---------------------------------------------------------------------
# Test / coverage artifacts
# ---------------------------------------------------------------------
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
*.cover

# ---------------------------------------------------------------------
# RAG corpus, local experiments, and office working files
# Keep the small README/.gitkeep placeholders, but never publish the local
# legal corpus, cache, or generated benchmark/render outputs by accident.
# ---------------------------------------------------------------------
RAG/documents/.semantic_cache.json
RAG/documents/laws/*
!RAG/documents/laws/.gitkeep
!RAG/documents/laws/README.md
RAG/documents/regulations/*
!RAG/documents/regulations/.gitkeep
!RAG/documents/regulations/README.md
RAG/documents/amendments/*
RAG/documents/quarantine/*
RAG/documents/uploads/*
!RAG/documents/uploads/README.md
RAG/documents/internal_docs/*
!RAG/documents/internal_docs/.gitkeep
!RAG/documents/internal_docs/README.md
RAG/evaluation/experiments/
RAG/evaluation/models/
RAG/evaluation/*_render*/
RAG/evaluation/mentor_report_render/
RAG/evaluation/report_render/

# Local CUDA/llama.cpp downloads and temporary document lock files
Inference/llama_server/cuda_bin/
Inference/llama_server/*.zip
~$*.docx
rag_*.log
rag_*.err.log
final_report_qa.pdf
rag_final_report_render/
rag_report_render/

llama/
llama.zip
llama-ui.tar.gz
*.tar.gz
