OCR_LANGUAGE=tr
OCR_VERSION=PP-OCRv5
OCR_STRUCTURE_VERSION=PP-StructureV3
# auto | cpu | gpu | gpu:0  (default gpu → CUDA if present, else CPU)
OCR_DEVICE=gpu
OCR_PERFORMANCE_PROFILE=development
OCR_PIPELINE=PP-StructureV3

OCR_CONFIDENCE_THRESHOLD=0.35
OCR_LOW_CONFIDENCE_THRESHOLD=0.55
OCR_QUALITY_THRESHOLD=0.5
OCR_MAX_ATTEMPTS=2
# OCR_MAX_FILE_SIZE_MB=
# OCR_MAX_PDF_PAGES=
# OCR_MAX_OFFICE_PAGES=
OCR_PDF_DPI=220

OCR_PREPROCESSING_ENABLED=true
OCR_GRAYSCALE=true
OCR_DENOISE=true
OCR_CONTRAST=true
OCR_SHARPEN=true
OCR_DESKEW=true
OCR_PERSPECTIVE_CORRECTION=true
OCR_AUTO_CROP=true
OCR_PALE_BOOST=true
OCR_ADAPTIVE_THRESHOLD=false
OCR_MIN_DIMENSION=1800
OCR_MAX_DIMENSION=5000
OCR_DESKEW_MAX_ANGLE=35

OCR_RAPID_FALLBACK=true
OCR_ENABLE_LAYOUT=true
OCR_ENABLE_TABLES=true
OCR_ENABLE_VISUAL_ELEMENTS=true
# Off: stops PP-LCNet / Structure companion stacks (speed)
OCR_DOC_ORIENTATION=false
OCR_DOC_UNWARPING=false
OCR_TEXTLINE_ORIENTATION=false
OCR_SEAL_RECOGNITION=false
OCR_SIGNATURE_DETECTION=true

# Vision fallback — local llama-server only (Inference/start_paddleocr_vl.bat)
OCR_VISION_FALLBACK_ENABLED=true
OCR_VISION_FALLBACK_PROVIDER=paddleocr-vl
OCR_VISION_FALLBACK_THRESHOLD=0.45
# OCR_MAX_VISION_PAGES=
OCR_VISION_FALLBACK_USE_SHARED_CLIENT=false
OCR_VISION_FALLBACK_TIMEOUT_S=600
OCR_VISION_FALLBACK_ENDPOINT=http://127.0.0.1:8111/v1/chat/completions
OCR_VISION_FALLBACK_MODEL=paddleocr-vl-1.6-gguf
OCR_VISION_FALLBACK_MAX_TOKENS=16384
OCR_VISION_FALLBACK_BAND_PX=1200
OCR_VISION_FALLBACK_BAND_OVERLAP=0.12
OCR_VISION_FALLBACK_CONTINUE_ROUNDS=12

OCR_STORAGE_UPLOADS_DIR=Storage/files/uploads
# OCR_MODEL_DIR=
# OCR_PIPELINE_CONFIG=
# OCR_CACHE_DIR=
# OCR_TEMP_DIR=
