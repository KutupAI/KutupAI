OCR_LANGUAGE=tr
OCR_VERSION=PP-OCRv5
OCR_STRUCTURE_VERSION=PP-StructureV3
# auto | cpu | gpu | gpu:0 -- "auto" detects a CUDA GPU at runtime and falls
# back to CPU; never hard-code a device id here.
OCR_DEVICE=auto
# development | production | high_performance
OCR_PERFORMANCE_PROFILE=development
OCR_PIPELINE=PP-StructureV3
OCR_CONFIDENCE_THRESHOLD=0.35
OCR_LOW_CONFIDENCE_THRESHOLD=0.55
OCR_QUALITY_THRESHOLD=0.5
OCR_MAX_ATTEMPTS=3
OCR_MAX_FILE_SIZE_MB=100
OCR_MAX_PDF_PAGES=500
OCR_MAX_OFFICE_PAGES=500
OCR_PDF_DPI=300
OCR_PREPROCESSING_ENABLED=true
OCR_GRAYSCALE=true
OCR_DENOISE=true
OCR_CONTRAST=true
OCR_SHARPEN=true
OCR_DESKEW=true
OCR_PERSPECTIVE_CORRECTION=true
OCR_AUTO_CROP=true
OCR_PALE_BOOST=true
OCR_ADAPTIVE_THRESHOLD=false
OCR_MIN_DIMENSION=1800
OCR_MAX_DIMENSION=5000
OCR_DESKEW_MAX_ANGLE=35
OCR_RAPID_FALLBACK=true
OCR_ENABLE_LAYOUT=true
OCR_ENABLE_TABLES=true
OCR_ENABLE_VISUAL_ELEMENTS=true
OCR_DOC_ORIENTATION=true
OCR_DOC_UNWARPING=true
OCR_TEXTLINE_ORIENTATION=true
OCR_SEAL_RECOGNITION=true
OCR_SIGNATURE_DETECTION=true

# Vision fallback (Qwen2.5-VL) -- used only when OCR is weak/incomplete or
# the page is dark/blurry/low-quality. Points at the local llama-server.
OCR_VISION_FALLBACK_ENABLED=true
OCR_VISION_FALLBACK_PROVIDER=qwen-vl
OCR_VISION_FALLBACK_THRESHOLD=0.45
OCR_VISION_FALLBACK_MAX_PAGES=8
OCR_VISION_FALLBACK_USE_SHARED_CLIENT=false
OCR_VISION_FALLBACK_TIMEOUT_S=240
OCR_VISION_FALLBACK_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
OCR_VISION_FALLBACK_MODEL=qwen-vl
OCR_VISION_FALLBACK_MAX_TOKENS=8192

# Optional overrides
# OCR_MODEL_DIR=
# OCR_PIPELINE_CONFIG=
# OCR_CACHE_DIR=
# OCR_TEMP_DIR=
