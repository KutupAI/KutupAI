# Documents every required environment variable without exposing sensitive values.
# Copy to `.env` and fill real keys locally — never commit `.env`.

# EVREN_LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# EVREN_LLM_API_KEY=...
# EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr/team08/
# EVREN_QDRANT_API_KEY=...
# EVREN_EMBED_MODEL=bge-m3-embed

WRITER_INFERENCE_BACKEND=evren
WRITER_EVREN_MODEL=llm-large
CLASSIFICATION_INFERENCE_BACKEND=evren
CLASSIFICATION_EVREN_MODEL=llm-fast
CLASSIFICATION_USE_FAST_CLASSIFIER=false
SUMMARY_INFERENCE_BACKEND=evren
SUMMARY_EVREN_MODEL=llm-large
