# Documents every required environment variable (ports, model paths, connection strings) without exposing sensitive values
# EVREN_LLM_BASE_URL=https://.../v1
# EVREN_LLM_API_KEY=...
# Sınıflandırma ve RAG özeti için önerilen API modelleri.
CLASSIFICATION_INFERENCE_BACKEND=evren
CLASSIFICATION_EVREN_MODEL=llm-fast
CLASSIFICATION_USE_FAST_CLASSIFIER=false
SUMMARY_INFERENCE_BACKEND=evren
SUMMARY_EVREN_MODEL=llm-large
